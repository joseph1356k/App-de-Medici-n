# ── Base de datos (Supabase, Neon, Vercel Postgres… cualquier Postgres) ─────────
# En Supabase: Project Settings → Database → Connection string (Transaction pooler, puerto 6543).
DATABASE_URL=postgres://postgres.xxxx:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ── Clave que usan los .exe para hablar con la API (X-API-Key). Cualquier texto largo. ────
MEDIDOR_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# ── Contraseña del panel web ─────────────────────────────────────────────────────
PANEL_PASSWORD=cambia-esto

# ── Opcional: Vercel lo manda en el cron (/api/tareas/resumir). Si no está, vale MEDIDOR_API_KEY.
CRON_SECRET=
